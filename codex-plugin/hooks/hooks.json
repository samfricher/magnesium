{
  "description": "Self-gating Magnesium lifecycle hooks backed by the native magnesium runtime.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "magnesium _internal hook session-start --plugin-version 0.2.0 --adapter-protocol-version 2",
            "commandWindows": "magnesium.exe _internal hook session-start --plugin-version 0.2.0 --adapter-protocol-version 2",
            "timeout": 2,
            "additionalContextLimit": 256
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "magnesium _internal hook user-prompt-submit --plugin-version 0.2.0 --adapter-protocol-version 2",
            "commandWindows": "magnesium.exe _internal hook user-prompt-submit --plugin-version 0.2.0 --adapter-protocol-version 2",
            "timeout": 2,
            "additionalContextLimit": 512
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "magnesium _internal hook stop --plugin-version 0.2.0 --adapter-protocol-version 2",
            "commandWindows": "magnesium.exe _internal hook stop --plugin-version 0.2.0 --adapter-protocol-version 2",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "magnesium _internal hook pre-compact --plugin-version 0.2.0 --adapter-protocol-version 2",
            "commandWindows": "magnesium.exe _internal hook pre-compact --plugin-version 0.2.0 --adapter-protocol-version 2",
            "timeout": 2
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "magnesium _internal hook post-compact --plugin-version 0.2.0 --adapter-protocol-version 2",
            "commandWindows": "magnesium.exe _internal hook post-compact --plugin-version 0.2.0 --adapter-protocol-version 2",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "magnesium _internal hook session-end --plugin-version 0.2.0 --adapter-protocol-version 2",
            "commandWindows": "magnesium.exe _internal hook session-end --plugin-version 0.2.0 --adapter-protocol-version 2",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
