#!/bin/sh
set -eu
ROOT=$(cd "$(dirname "$0")" && pwd)
BUILD=no
if [ "${1:-}" = "--build" ]; then
  BUILD=yes
  shift
fi
FOLDER=${1:-}
if [ -n "$FOLDER" ]; then
  FOLDER=$(cd "$FOLDER" && pwd)
fi
cd "$ROOT"
APP="$ROOT/target/release/bundle/macos/Magnesium.app"
BIN="$APP/Contents/MacOS/magnesium-window"

[ -x "$BIN" ] || BUILD=yes
if [ "$BUILD" = yes ]; then
  [ -d node_modules ] || npm install
  npx tauri build --bundles app
fi

if [ -n "$FOLDER" ]; then
  exec "$BIN" "$FOLDER"
fi
exec "$BIN"
