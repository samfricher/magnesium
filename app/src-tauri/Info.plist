<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist by the bundler. It names the icon in
     icons/Assets.car itself; the name it would read from the file with
     assetutil may be missing on a Mac whose Xcode is older than the actool
     that compiled it. -->
<plist version="1.0">
<dict>
	<key>CFBundleIconName</key>
	<string>Icon</string>
</dict>
</plist>
